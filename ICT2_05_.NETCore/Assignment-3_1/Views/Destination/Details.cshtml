@model Tuple<int, string, string, int, string>

<h1>Destination Details</h1>

<table border="1" cellpadding="5">
    <tr>
        <th>ID</th>
        <td>@Model.Item1</td>
    </tr>
    <tr>
        <th>Name</th>
        <td>@Model.Item2</td>
    </tr>
    <tr>
        <th>Country</th>
        <td>@Model.Item3</td>
    </tr>
    <tr>
        <th>Estimated Cost</th>
        <td>@Model.Item4</td>
    </tr>
    <tr>
        <th>Best Season</th>
        <td>@Model.Item5</td>
    </tr>
</table>

<p>
    <a href="/Destination/Edit/@Model.Item1">Edit</a> |
    <a href="/Destination">Back to List</a>
</p>