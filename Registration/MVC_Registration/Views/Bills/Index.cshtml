@model IEnumerable<MVC_Registration.Models.Bill>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.UnitsConsumed)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Billamount)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Surcharge)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FinalBill)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.User)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.UnitsConsumed)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Billamount)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Surcharge)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FinalBill)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.User.Name)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.BillId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.BillId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.BillId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
