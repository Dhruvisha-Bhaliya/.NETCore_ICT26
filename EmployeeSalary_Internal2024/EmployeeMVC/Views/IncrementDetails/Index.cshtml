@model IEnumerable<EmployeeMVC.Models.IncrementDetail>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.BasicSalary)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Increment)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NewBasicSalary)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Employee)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.BasicSalary)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Increment)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.NewBasicSalary)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Employee.Name)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.IncrementId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.IncrementId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.IncrementId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
